@namespace ANetD.Components.Layout

<div class="@CssClass" style="@Style" @attributes="AdditionalAttributes">
    @if (Header is not null)
    {
        <div class="anetd-card__header">@Header</div>
    }
    @if (ChildContent is not null)
    {
        <div class="anetd-card__body">@ChildContent</div>
    }
    @if (Footer is not null)
    {
        <div class="anetd-card__footer">@Footer</div>
    }
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? Header { get; set; }
    [Parameter] public RenderFragment? Footer { get; set; }
    [Parameter] public bool NoPadding { get; set; }
    [Parameter] public bool Flat { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public string? Style { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private string CssClass => new ANetD.Utilities.CssBuilder()
        .Add("anetd-card")
        .AddIf("anetd-card--no-padding", NoPadding)
        .AddIf("anetd-card--flat", Flat)
        .Add(Class)
        .Build();
}
