@namespace ANetD.Components.Navigation

<nav aria-label="Breadcrumb" @attributes="AdditionalAttributes">
    <ol class="@CssClass">@ChildContent</ol>
</nav>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private string CssClass => new ANetD.Utilities.CssBuilder().Add("anetd-breadcrumb").Add(Class).Build();
}
