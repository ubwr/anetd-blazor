@namespace ANetD.Components.Navigation

<button type="button" role="tab" class="@CssClass"
        aria-selected="@(Active ? "true" : "false")"
        aria-controls="@PanelId"
        @onclick="HandleClick"
        @attributes="AdditionalAttributes">
    @if (Icon is not null)
    {
        <span class="anetd-tab__icon" aria-hidden="true">@Icon</span>
    }
    @ChildContent
</button>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? Icon { get; set; }
    [Parameter] public bool Active { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string? PanelId { get; set; }
    [Parameter] public EventCallback OnClick { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private string CssClass => new ANetD.Utilities.CssBuilder()
        .Add("anetd-tab")
        .AddIf("anetd-tab--active", Active)
        .AddIf("anetd-tab--disabled", Disabled)
        .Add(Class)
        .Build();

    private async Task HandleClick() { if (!Disabled) await OnClick.InvokeAsync(); }
}
