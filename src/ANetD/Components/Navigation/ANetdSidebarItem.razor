@namespace ANetD.Components.Navigation

<a href="@Href" class="@CssClass" aria-current="@(Active ? "page" : null)" @attributes="AdditionalAttributes">
    @if (Icon is not null)
    {
        <span class="anetd-sidebar-item__icon" aria-hidden="true">@Icon</span>
    }
    <span class="anetd-sidebar-item__label">@Label</span>
    @if (Badge is not null)
    {
        <span class="anetd-sidebar-item__badge">@Badge</span>
    }
</a>

@code {
    [Parameter] public string? Label { get; set; }
    [Parameter] public string? Href { get; set; }
    [Parameter] public RenderFragment? Icon { get; set; }
    [Parameter] public RenderFragment? Badge { get; set; }
    [Parameter] public bool Active { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private string CssClass => new ANetD.Utilities.CssBuilder()
        .Add("anetd-sidebar-item")
        .AddIf("anetd-sidebar-item--active", Active)
        .Add(Class)
        .Build();
}
