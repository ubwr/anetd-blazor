@namespace ANetD.Components.Navigation

<header class="@CssClass" style="@Style" @attributes="AdditionalAttributes">
    <div class="anetd-navbar__inner">
        @if (Brand is not null)
        {
            <div class="anetd-navbar__brand">@Brand</div>
        }
        <nav class="anetd-navbar__content" aria-label="Main navigation">
            @ChildContent
        </nav>
        @if (Actions is not null)
        {
            <div class="anetd-navbar__actions">@Actions</div>
        }
    </div>
</header>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? Brand { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
    [Parameter] public bool Sticky { get; set; }
    [Parameter] public bool Bordered { get; set; } = true;
    [Parameter] public string? Class { get; set; }
    [Parameter] public string? Style { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private string CssClass => new ANetD.Utilities.CssBuilder()
        .Add("anetd-navbar")
        .AddIf("anetd-navbar--sticky", Sticky)
        .AddIf("anetd-navbar--bordered", Bordered)
        .Add(Class)
        .Build();
}
