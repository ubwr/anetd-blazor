@namespace ANetD.Components.Navigation

<a href="@Href" class="@CssClass" aria-current="@(Active ? "page" : null)" @attributes="AdditionalAttributes">
    @if (Icon is not null)
    {
        <span class="anetd-nav-item__icon" aria-hidden="true">@Icon</span>
    }
    @if (ChildContent is not null)
    {
        <span class="anetd-nav-item__label">@ChildContent</span>
    }
</a>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? Icon { get; set; }
    [Parameter] public string? Href { get; set; }
    [Parameter] public bool Active { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private string CssClass => new ANetD.Utilities.CssBuilder()
        .Add("anetd-nav-item")
        .AddIf("anetd-nav-item--active", Active)
        .AddIf("anetd-nav-item--disabled", Disabled)
        .Add(Class)
        .Build();
}
