@namespace ANetD.Components.Typography

@switch (As)
{
    case "h1":    <h1    class="@CssClass" style="@Style" @attributes="AdditionalAttributes">@ChildContent</h1>; break;
    case "h2":    <h2    class="@CssClass" style="@Style" @attributes="AdditionalAttributes">@ChildContent</h2>; break;
    case "h3":    <h3    class="@CssClass" style="@Style" @attributes="AdditionalAttributes">@ChildContent</h3>; break;
    case "h4":    <h4    class="@CssClass" style="@Style" @attributes="AdditionalAttributes">@ChildContent</h4>; break;
    case "h5":    <h5    class="@CssClass" style="@Style" @attributes="AdditionalAttributes">@ChildContent</h5>; break;
    case "h6":    <h6    class="@CssClass" style="@Style" @attributes="AdditionalAttributes">@ChildContent</h6>; break;
    case "code":  <code  class="@CssClass" style="@Style" @attributes="AdditionalAttributes">@ChildContent</code>; break;
    case "small": <small class="@CssClass" style="@Style" @attributes="AdditionalAttributes">@ChildContent</small>; break;
    case "p":     <p     class="@CssClass" style="@Style" @attributes="AdditionalAttributes">@ChildContent</p>; break;
    default:      <span  class="@CssClass" style="@Style" @attributes="AdditionalAttributes">@ChildContent</span>; break;
}

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string As { get; set; } = "p";
    [Parameter] public string? Class { get; set; }
    [Parameter] public string? Style { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private string CssClass => new ANetD.Utilities.CssBuilder()
        .Add(As switch { "h1" => "anetd-h1", "h2" => "anetd-h2", "h3" => "anetd-h3", "h4" => "anetd-h4", "h5" => "anetd-h5", "h6" => "anetd-h6", "code" => "anetd-code", _ => "anetd-text-body" })
        .Add(Class).Build();
}
