@namespace ANetD.Components.Feedback
@inject IToastService ToastService
@implements IDisposable

<div class="anetd-toast-container anetd-toast-container--top-right">
    @foreach (var toast in _toasts)
    {
        <ANetdToast Message="@toast" OnDismiss="Dismiss" />
    }
</div>

@code {
    private readonly List<ToastMessage> _toasts = new();
    private readonly List<Timer> _timers = new();

    protected override void OnInitialized()
    {
        ToastService.OnToast += HandleToast;
    }

    private void HandleToast(ToastMessage message)
    {
        InvokeAsync(() =>
        {
            _toasts.Add(message);
            StateHasChanged();
            if (message.DurationMs > 0)
            {
                var timer = new Timer(_ => InvokeAsync(() => Dismiss(message.Id)), null, message.DurationMs, Timeout.Infinite);
                _timers.Add(timer);
            }
        });
    }

    private void Dismiss(string id)
    {
        var toast = _toasts.FirstOrDefault(t => t.Id == id);
        if (toast is not null) { _toasts.Remove(toast); StateHasChanged(); }
    }

    public void Dispose()
    {
        ToastService.OnToast -= HandleToast;
        foreach (var timer in _timers) timer.Dispose();
    }
}
