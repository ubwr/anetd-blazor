@namespace ANetD.Components.Feedback

<span class="@CssClass" @attributes="AdditionalAttributes">@ChildContent</span>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public ComponentColor Color { get; set; } = ComponentColor.Default;
    [Parameter] public bool Dot { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private string CssClass => new ANetD.Utilities.CssBuilder()
        .Add("anetd-badge")
        .Add(Color switch { ComponentColor.Primary => "anetd-badge--primary", ComponentColor.Success => "anetd-badge--success", ComponentColor.Warning => "anetd-badge--warning", ComponentColor.Danger => "anetd-badge--danger", ComponentColor.Info => "anetd-badge--info", ComponentColor.Secondary => "anetd-badge--secondary", _ => "anetd-badge--default" })
        .AddIf("anetd-badge--dot", Dot)
        .Add(Class).Build();
}
