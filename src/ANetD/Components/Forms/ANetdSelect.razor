@namespace ANetD.Components.Forms
@typeparam TValue

<div class="anetd-field @WrapperClass">
    @if (!string.IsNullOrEmpty(Label))
    {
        <label for="@_id" class="anetd-label">
            @Label
            @if (Required) { <span class="anetd-label__required" aria-hidden="true">*</span> }
        </label>
    }
    <div class="anetd-select-wrapper">
        <select id="@_id"
                class="@SelectClass"
                disabled="@Disabled"
                aria-required="@(Required ? "true" : null)"
                @onchange="HandleChange"
                @attributes="AdditionalAttributes">
            @if (!string.IsNullOrEmpty(Placeholder))
            {
                <option value="" disabled selected="@(Value == null)">@Placeholder</option>
            }
            @ChildContent
        </select>
        <span class="anetd-select__arrow" aria-hidden="true">
            <svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M2 4L6 8L10 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
        </span>
    </div>
    @if (!string.IsNullOrEmpty(HelpText))
    {
        <div class="anetd-field-help">@HelpText</div>
    }
</div>

@code {
    private readonly string _id = $"anetd-select-{Guid.NewGuid():N}";

    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public TValue? Value { get; set; }
    [Parameter] public EventCallback<TValue?> ValueChanged { get; set; }
    [Parameter] public string? Label { get; set; }
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public ComponentSize Size { get; set; } = ComponentSize.Md;
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool Required { get; set; }
    [Parameter] public string? HelpText { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private string WrapperClass => Class ?? string.Empty;

    private string SelectClass => new ANetD.Utilities.CssBuilder()
        .Add("anetd-select")
        .Add(Size switch { ComponentSize.Sm => "anetd-select--sm", ComponentSize.Lg => "anetd-select--lg", _ => "" })
        .Build();

    private async Task HandleChange(ChangeEventArgs e)
    {
        var stringVal = e.Value?.ToString();
        TValue? result = default;
        if (stringVal is not null)
        {
            try { result = (TValue?)Convert.ChangeType(stringVal, typeof(TValue)); } catch { }
        }
        await ValueChanged.InvokeAsync(result);
    }
}
