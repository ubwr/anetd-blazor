@namespace ANetD.Components.Forms

<button type="@Type"
        class="@CssClass"
        style="@Style"
        disabled="@Disabled"
        aria-disabled="@(Disabled ? "true" : null)"
        aria-busy="@(Loading ? "true" : null)"
        @onclick="HandleClick"
        @attributes="AdditionalAttributes">
    @if (Loading)
    {
        <span class="anetd-button__spinner" aria-hidden="true"></span>
    }
    @if (IconStart is not null && !Loading)
    {
        <span class="anetd-button__icon" aria-hidden="true">@IconStart</span>
    }
    @if (ChildContent is not null)
    {
        <span class="anetd-button__label">@ChildContent</span>
    }
    @if (IconEnd is not null && !Loading)
    {
        <span class="anetd-button__icon" aria-hidden="true">@IconEnd</span>
    }
</button>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? IconStart { get; set; }
    [Parameter] public RenderFragment? IconEnd { get; set; }
    [Parameter] public ButtonVariant Variant { get; set; } = ButtonVariant.Primary;
    [Parameter] public ComponentSize Size { get; set; } = ComponentSize.Md;
    [Parameter] public string Type { get; set; } = "button";
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool Loading { get; set; }
    [Parameter] public bool FullWidth { get; set; }
    [Parameter] public bool IconOnly { get; set; }
    [Parameter] public EventCallback<MouseEventArgs> OnClick { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public string? Style { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private string CssClass => new ANetD.Utilities.CssBuilder()
        .Add("anetd-button")
        .Add(Variant switch
        {
            ButtonVariant.Secondary => "anetd-button--secondary",
            ButtonVariant.Ghost     => "anetd-button--ghost",
            ButtonVariant.Danger    => "anetd-button--danger",
            ButtonVariant.Link      => "anetd-button--link",
            _                       => "anetd-button--primary",
        })
        .Add(Size switch
        {
            ComponentSize.Sm => "anetd-button--sm",
            ComponentSize.Lg => "anetd-button--lg",
            _                => "anetd-button--md",
        })
        .AddIf("anetd-button--full-width", FullWidth)
        .AddIf("anetd-button--icon-only", IconOnly)
        .AddIf("anetd-button--loading", Loading)
        .Add(Class)
        .Build();

    private async Task HandleClick(MouseEventArgs e)
    {
        if (!Disabled && !Loading)
            await OnClick.InvokeAsync(e);
    }
}
