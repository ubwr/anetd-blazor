@namespace ANetD.Components.Forms

<div class="@CssClass" role="radiogroup" aria-label="@AriaLabel" @attributes="AdditionalAttributes">
    @ChildContent
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string? AriaLabel { get; set; }
    [Parameter] public bool Horizontal { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private string CssClass => new ANetD.Utilities.CssBuilder()
        .Add("anetd-radio-group")
        .AddIf("anetd-radio-group--horizontal", Horizontal)
        .Add(Class)
        .Build();
}
