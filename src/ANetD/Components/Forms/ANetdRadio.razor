@namespace ANetD.Components.Forms

<label class="@LabelClass" @attributes="AdditionalAttributes">
    <input type="radio"
           class="anetd-radio__input"
           name="@GroupName"
           value="@Value"
           checked="@IsChecked"
           disabled="@Disabled"
           @onchange="HandleChange" />
    <span class="anetd-radio__circle" aria-hidden="true"></span>
    @if (!string.IsNullOrEmpty(Label))
    {
        <span class="anetd-radio__label">@Label</span>
    }
</label>

@code {
    [Parameter] public string? Label { get; set; }
    [Parameter] public string? Value { get; set; }
    [Parameter] public string? GroupName { get; set; }
    [Parameter] public string? SelectedValue { get; set; }
    [Parameter] public EventCallback<string?> SelectedValueChanged { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private bool IsChecked => Value == SelectedValue;

    private string LabelClass => new ANetD.Utilities.CssBuilder()
        .Add("anetd-radio")
        .AddIf("anetd-radio--disabled", Disabled)
        .Add(Class)
        .Build();

    private async Task HandleChange(ChangeEventArgs e)
    {
        if (!Disabled)
            await SelectedValueChanged.InvokeAsync(Value);
    }
}
