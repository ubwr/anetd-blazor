@namespace ANetD.Components.Forms
@inherits InputBase<string?>

<div class="@WrapperClass">
    @if (!string.IsNullOrEmpty(Label))
    {
        <label for="@_inputId" class="anetd-label">
            @Label
            @if (Required) { <span class="anetd-label__required" aria-hidden="true">*</span> }
        </label>
    }
    <div class="anetd-input-wrapper">
        @if (PrefixContent is not null)
        {
            <div class="anetd-input__prefix">@PrefixContent</div>
        }
        else if (!string.IsNullOrEmpty(Prefix))
        {
            <div class="anetd-input__prefix">@Prefix</div>
        }
        <input id="@_inputId"
               type="@Type"
               class="@InputClass"
               value="@CurrentValue"
               placeholder="@Placeholder"
               disabled="@Disabled"
               readonly="@ReadOnly"
               aria-required="@(Required ? "true" : null)"
               aria-invalid="@(HasError ? "true" : null)"
               aria-describedby="@(HasError ? $"{_inputId}-error" : null)"
               @oninput="HandleInput"
               @onblur="HandleBlur"
               @attributes="AdditionalAttributes" />
        @if (SuffixContent is not null)
        {
            <div class="anetd-input__suffix">@SuffixContent</div>
        }
        else if (!string.IsNullOrEmpty(Suffix))
        {
            <div class="anetd-input__suffix">@Suffix</div>
        }
    </div>
    @if (HasError && ShowValidationMessage)
    {
        <div id="@(_inputId + "-error")" class="anetd-field-error" role="alert">
            @(EditContext?.GetValidationMessages(FieldIdentifier).FirstOrDefault() ?? string.Empty)
        </div>
    }
    @if (!string.IsNullOrEmpty(HelpText) && !HasError)
    {
        <div class="anetd-field-help">@HelpText</div>
    }
</div>

@code {
    private readonly string _inputId = $"anetd-input-{Guid.NewGuid():N}";

    [Parameter] public string? Label { get; set; }
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public string Type { get; set; } = "text";
    [Parameter] public string? Prefix { get; set; }
    [Parameter] public string? Suffix { get; set; }
    [Parameter] public RenderFragment? PrefixContent { get; set; }
    [Parameter] public RenderFragment? SuffixContent { get; set; }
    [Parameter] public ComponentSize Size { get; set; } = ComponentSize.Md;
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool ReadOnly { get; set; }
    [Parameter] public bool Required { get; set; }
    [Parameter] public bool ShowValidationMessage { get; set; } = true;
    [Parameter] public string? HelpText { get; set; }
    [Parameter] public string? Class { get; set; }

    private bool HasError => EditContext is not null && EditContext.GetValidationMessages(FieldIdentifier).Any();

    private string WrapperClass => new ANetD.Utilities.CssBuilder()
        .Add("anetd-field")
        .Add(Class)
        .Build();

    private string InputClass => new ANetD.Utilities.CssBuilder()
        .Add("anetd-input")
        .Add(Size switch { ComponentSize.Sm => "anetd-input--sm", ComponentSize.Lg => "anetd-input--lg", _ => "" })
        .AddIf("anetd-input--error", HasError)
        .AddIf("anetd-input--has-prefix", PrefixContent is not null || !string.IsNullOrEmpty(Prefix))
        .AddIf("anetd-input--has-suffix", SuffixContent is not null || !string.IsNullOrEmpty(Suffix))
        .Build();

    protected override bool TryParseValueFromString(string? value, out string? result, out string validationErrorMessage)
    {
        result = value;
        validationErrorMessage = string.Empty;
        return true;
    }

    private void HandleInput(ChangeEventArgs e)
    {
        CurrentValueAsString = e.Value?.ToString();
    }

    private void HandleBlur(FocusEventArgs e)
    {
        EditContext?.NotifyFieldChanged(FieldIdentifier);
    }
}
